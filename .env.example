# --- Accès à l'interface ---------------------------------------------------
# 127.0.0.1 : accès par tunnel SSH ou reverse proxy.
SPACESEED_BIND=127.0.0.1
SPACESEED_PORT=8095
SPACESEED_USERNAME=admin
# Authentification active dès que ce mot de passe est renseigné.
SPACESEED_PASSWORD=

# --- Prowlarr ---------------------------------------------------------------
# Utiliser une IP joignable aussi par qBittorrent, jamais localhost.
TORZNAB_URL=http://IP_PROWLARR:9696/api/v1/indexer/1/newznab
TORZNAB_API_KEY=change-me
TORZNAB_LIMIT=100
TORZNAB_CATEGORIES=

# --- qBittorrent ------------------------------------------------------------
QBITTORRENT_URL=http://IP_DU_NAS:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=change-me
QBITTORRENT_CATEGORY=spaceseed
# Chemin vu par qBittorrent. Vide : son dossier par défaut.
QBITTORRENT_SAVE_PATH=
QBITTORRENT_PAUSED=false

# --- C411 --------------------------------------------------------------------
# Contrôle actif dès que la clé est renseignée (scope « Profil (lecture) »).
C411_API_KEY=
# Marge à conserver après chaque téléchargement non FreeLeech.
C411_MIN_MARGIN_GB=20

# --- Telegram ----------------------------------------------------------------
# Alertes actives dès que le token et le chat sont renseignés.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SCORE=150
TELEGRAM_FREELEECH_ONLY=false
TELEGRAM_MAX_PER_SCAN=5

# --- Scan --------------------------------------------------------------------
SCAN_INTERVAL_MINUTES=5
STALE_AFTER_MINUTES=30
SCAN_HISTORY_DAYS=30
REQUEST_TIMEOUT_SECONDS=30
MIN_LEECHERS=1
MAX_SEEDERS=9999
FREELEECH_ONLY=false

# --- Envoi automatique -------------------------------------------------------
# Valeurs prudentes pour 20 Mbps d'upload, à augmenter avec une ligne plus rapide.
AUTO_GRAB_ENABLED=false
AUTO_GRAB_MIN_SCORE=150
AUTO_GRAB_MIN_SEEDERS=1
AUTO_GRAB_FREELEECH_ONLY=true
AUTO_GRAB_MAX_SIZE_GB=15
AUTO_GRAB_MAX_PER_SCAN=1
AUTO_GRAB_MAX_ACTIVE=2
AUTO_GRAB_MIN_FREE_SPACE_GB=50

# --- Conteneur ---------------------------------------------------------------
# Propriétaire de ./data (commande : id).
PUID=1000
PGID=1000
APP_NAME=SpaceSeed
DATABASE_URL=sqlite:////app/data/spaceseed.db
